# MediSync Hospital Management System - Environment Variables
NODE_ENV=production
PORT=3000

# Database Configuration (PostgreSQL / Embedded)
POSTGRES_USER=medisync_admin
POSTGRES_PASSWORD=secure_hospital_password_change_in_prod
POSTGRES_DB=medisync_hms
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://medisync_admin:secure_hospital_password_change_in_prod@localhost:5432/medisync_hms

# JWT & Security Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS & Frontend Origins
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# External Notifications (Development-mode mock providers)
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
MOCK_NOTIFICATION_LOGGING=true
